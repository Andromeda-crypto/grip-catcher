<mujoco model="actuated_arm">
    <compiler angle="degree" coordinate="local"/>
    <option timestep="0.002" gravity="0 0 -9.81"/>

    <asset>
        <texture type="skybox" builtin="gradient" rgb1="0.1 0.1 0.2" rgb2="0.5 0.6 0.7" width="512" height="512"/>
        <texture name="grid" type="2d" builtin="checker" rgb1="0.8 0.8 0.8" rgb2="0.9 0.9 0.9" width="512" height="512"/>
        <material name="floor" texture="grid" texrepeat="2 2" texuniform="true"/>
    </asset>

    <worldbody>
        <geom name="floor" type="plane" size="3 3 0.1" material="floor"/>
        <light directional="true" diffuse="0.8 0.8 0.8" pos="0 0 5" dir="0 0 -1"/>

        <!-- Robot Pedestal -->
        <body name="pedestal" pos="0 0 0">
            <geom name="pedestal_geom" type="cylinder" size="0.1 0.4" pos="0 0 0.4" rgba="0.2 0.2 0.2 1"/>
            
            <!-- Arm Link 1 (Rotates around Z axis) -->
            <body name="arm_link1" pos="0 0 0.8">
                <joint name="shoulder" type="hinge" axis="0 0 1" range="-180 180" limited="true" damping="1.5"/>
                <geom name="link1_geom" type="box" size="0.2 0.05 0.05" pos="0.2 0 0" rgba="0.9 0.4 0.1 1"/>
                
                <!-- Arm Link 2 (Rotates around Z axis relative to link 1) -->
                <body name="arm_link2" pos="0.4 0 0">
                    <joint name="elbow" type="hinge" axis="0 0 1" range="-150 150" limited="true" damping="1.0"/>
                    <geom name="link2_geom" type="box" size="0.15 0.04 0.04" pos="0.15 0 0" rgba="0.1 0.7 0.4 1"/>
                    
                    <!-- End Effector Marker -->
                    <site name="end_effector" pos="0.3 0 0" size="0.02" rgba="1 0 0 1"/>
                </body>
            </body>
        </body>
    </worldbody>

    <!-- Actuators mapping control signals directly to joints -->
    <actuator>
        <motor name="shoulder_motor" joint="shoulder" gear="50" ctrlrange="-1 1"/>
        <position name="elbow_servo" joint="elbow" kp="200" ctrlrange="-150 150"/>
    </actuator>
</mujoco>
